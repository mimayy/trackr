# =============================================================================
# Trackr@Uni-Ace - environment configuration
#
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# NEVER commit `.env`. Every value below is read from the environment at
# runtime - nothing is hard-coded in source.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
#
# Local (docker compose)  -> jdbc:postgresql://db:5432/trackr
# Local (host machine)    -> jdbc:postgresql://localhost:5432/trackr
# Neon (free tier)        -> jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/trackr?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/trackr
DATABASE_USERNAME=trackr
DATABASE_PASSWORD=trackr

# -----------------------------------------------------------------------------
# Security
#
# JWT_SECRET must be at least 32 characters (256 bits). Generate one with:
#   openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

# Bootstrap administrator. Only used the very first time the database is
# migrated; afterwards the password lives (hashed) in the database.
BOOTSTRAP_ADMIN_EMAIL=admin@uni-ace.example
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# -----------------------------------------------------------------------------
# URLs (used for CORS and for building activation links)
#
# Production example:
#   APP_BASE_URL=https://trackr-uni-ace.vercel.app
#   FRONTEND_URL=https://trackr-uni-ace.vercel.app
#   BACKEND_URL=https://trackr-uni-ace-api.onrender.com
#
# FRONTEND_URL accepts a comma-separated list of allowed origins.
# -----------------------------------------------------------------------------
APP_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# WebAuthn (device fingerprint / passkey)
#
# WEBAUTHN_RP_ID must be the *domain only* of the site the employee opens -
# no scheme, no port. For localhost development use exactly `localhost`.
# WEBAUTHN_ORIGINS is a comma-separated list of full origins that may register
# or use credentials.
# -----------------------------------------------------------------------------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Trackr@Uni-Ace
WEBAUTHN_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Maps
#
# The default map uses OpenStreetMap raster tiles, which need no API key and
# are free. MAP_TILE_URL / MAP_API_KEY only matter if you swap in a provider
# that requires a key (e.g. MapTiler free tier).
# -----------------------------------------------------------------------------
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
MAP_API_KEY=

# -----------------------------------------------------------------------------
# Photo evidence storage
#
# STORAGE_PROVIDER = local | supabase
#   local    -> writes to STORAGE_LOCAL_PATH. Development only; Render's free
#               filesystem is ephemeral, so never use this in production.
#   supabase -> Supabase Storage (free tier). Create a *private* bucket.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/photos

STORAGE_URL=https://your-project-ref.supabase.co
STORAGE_BUCKET=trackr-photos
# Service role key - server side only, never expose to the browser.
STORAGE_KEY=
STORAGE_SECRET=

# -----------------------------------------------------------------------------
# Optional email for activation invitations.
#
# Activation always works without this: the administrator can copy the
# activation link from the UI. Email is a convenience, never a hard dependency.
# EMAIL_PROVIDER = none | resend
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=Trackr@Uni-Ace <no-reply@uni-ace.example>

# -----------------------------------------------------------------------------
# Application behaviour
# -----------------------------------------------------------------------------
APP_TIMEZONE=Asia/Manila

# Activation invitations expire after this many hours.
ACTIVATION_TOKEN_HOURS=48

# GPS quality thresholds, in metres.
#   Worse than GPS_MAX_ACCURACY_M  -> event is refused online ("move to an
#                                     open area"), flagged when synced offline.
#   Worse than GPS_WARN_ACCURACY_M -> event is accepted but flagged for review.
GPS_MAX_ACCURACY_M=150
GPS_WARN_ACCURACY_M=50

# Minutes of grace before a Time In counts as late.
ATTENDANCE_LATE_GRACE_MINUTES=0
# Minutes past the scheduled end before overtime is counted.
ATTENDANCE_OVERTIME_THRESHOLD_MINUTES=30

# How long work events, photos and audit logs are kept. 0 = keep forever.
RETENTION_WORK_EVENT_DAYS=1095
RETENTION_PHOTO_DAYS=365
RETENTION_AUDIT_LOG_DAYS=1095

# Load realistic demo employees and work events on startup.
# Turn this OFF for a real deployment.
SEED_DEMO_DATA=true
# Password given to every seeded demo account.
SEED_DEMO_PASSWORD=Trackr123!

# -----------------------------------------------------------------------------
# Frontend build-time variables (Vite). These are baked into the JS bundle,
# so they must never contain secrets.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
